group scaffold;
delimiters "%", "%"

workerClass(packageName, className, processId, taskId) ::= <<
package %packageName%;

import jakarta.enterprise.context.ApplicationScoped;
import org.eclipse.microprofile.reactive.messaging.Incoming;
import org.eclipse.microprofile.reactive.messaging.Outgoing;
import se.fk.kafka.ProcessEvent;

import java.util.HashMap;
import java.util.Map;

@ApplicationScoped
public class %className% {

    @Incoming("%processId%_%taskId%_input")
    @Outgoing("%processId%_%taskId%_output")
    public String handle(String payload) {
        ProcessEvent inputEvent = ProcessEvent.fromJson(payload);
        Map<String, Object> outputPayload = new HashMap<>();
        if (inputEvent.payload() != null) {
            outputPayload.putAll(inputEvent.payload());
        }
        outputPayload.put("worker", "%taskId%");

        ProcessEvent outputEvent = new ProcessEvent(
                inputEvent.processInstanceId(),
                inputEvent.processId(),
                "%taskId%",
                inputEvent.tokenId(),
                inputEvent.correlationId(),
                outputPayload,
                ProcessEvent.Status.COMPLETED,
                null
        );

        return outputEvent.toJson();
    }
}
>>

transactionalWorkerClass(packageName, className, processId, taskId) ::= <<
package %packageName%;

import org.apache.kafka.clients.consumer.ConsumerConfig;
import org.apache.kafka.clients.consumer.ConsumerRecord;
import org.apache.kafka.clients.consumer.ConsumerRecords;
import org.apache.kafka.clients.consumer.KafkaConsumer;
import org.apache.kafka.clients.consumer.OffsetAndMetadata;
import org.apache.kafka.clients.producer.KafkaProducer;
import org.apache.kafka.clients.producer.ProducerConfig;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.apache.kafka.common.TopicPartition;
import org.apache.kafka.common.serialization.StringDeserializer;
import org.apache.kafka.common.serialization.StringSerializer;
import se.fk.kafka.ProcessEvent;

import java.time.Duration;
import java.util.HashMap;
import java.util.Map;
import java.util.Properties;
import java.util.UUID;

public class %className% {
    public static void main(String[] args) {
        String bootstrap = args.length > 0 ? args[0] : "localhost:9094";
        String groupId = args.length > 1 ? args[1] : "%processId%_%taskId%_group";
        long timeoutSeconds = args.length > 2 ? Long.parseLong(args[2]) : 60;

        Properties consumerProps = new Properties();
        consumerProps.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap);
        consumerProps.put(ConsumerConfig.GROUP_ID_CONFIG, groupId);
        consumerProps.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class.getName());
        consumerProps.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class.getName());
        consumerProps.put(ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, "false");
        consumerProps.put(ConsumerConfig.ISOLATION_LEVEL_CONFIG, "read_committed");

        Properties producerProps = new Properties();
        producerProps.put(ProducerConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap);
        producerProps.put(ProducerConfig.KEY_SERIALIZER_CLASS_CONFIG, StringSerializer.class.getName());
        producerProps.put(ProducerConfig.VALUE_SERIALIZER_CLASS_CONFIG, StringSerializer.class.getName());
        producerProps.put(ProducerConfig.ENABLE_IDEMPOTENCE_CONFIG, "true");
        producerProps.put(ProducerConfig.TRANSACTIONAL_ID_CONFIG, "%processId%_%taskId%_" + UUID.randomUUID());

        String inputTopic = "%processId%_%taskId%_input";
        String outputTopic = "%processId%_%taskId%_output";

        try (KafkaConsumer<String, String> consumer = new KafkaConsumer<>(consumerProps);
             KafkaProducer<String, String> producer = new KafkaProducer<>(producerProps)) {
            producer.initTransactions();
            consumer.subscribe(java.util.Collections.singletonList(inputTopic));

            long deadlineMs = System.currentTimeMillis() + (timeoutSeconds * 1000);
            while (System.currentTimeMillis() < deadlineMs) {
                ConsumerRecords<String, String> records = consumer.poll(Duration.ofSeconds(1));
                if (records.isEmpty()) {
                    continue;
                }
                for (ConsumerRecord<String, String> record : records) {
                    producer.beginTransaction();
                    ProcessEvent inputEvent = ProcessEvent.fromJson(record.value());
                    Map<String, Object> payload = new HashMap<>();
                    if (inputEvent.payload() != null) {
                        payload.putAll(inputEvent.payload());
                    }
                    payload.put("worker", "%taskId%");
                    ProcessEvent outputEvent = new ProcessEvent(
                            inputEvent.processInstanceId(),
                            inputEvent.processId(),
                            "%taskId%",
                            inputEvent.tokenId(),
                            inputEvent.correlationId(),
                            payload,
                            ProcessEvent.Status.COMPLETED,
                            null
                    );
                    producer.send(new ProducerRecord<>(outputTopic, record.key(), outputEvent.toJson()));
                    producer.sendOffsetsToTransaction(
                            java.util.Collections.singletonMap(
                                    new TopicPartition(record.topic(), record.partition()),
                                    new OffsetAndMetadata(record.offset() + 1)
                            ),
                            consumer.groupMetadata()
                    );
                    producer.commitTransaction();
                }
            }
        }
    }
}
>>

xorGatewayClass(packageName, className, inputChannel, outputs) ::= <<
package %packageName%;

import jakarta.enterprise.context.ApplicationScoped;
import jakarta.inject.Inject;
import org.eclipse.microprofile.reactive.messaging.Channel;
import org.eclipse.microprofile.reactive.messaging.Emitter;
import org.eclipse.microprofile.reactive.messaging.Incoming;
import org.eclipse.microprofile.reactive.messaging.Message;
import se.fk.kafka.ProcessEvent;

import java.util.Map;
import java.util.concurrent.CompletionStage;

@ApplicationScoped
public class %className% {
%outputs:{o|

    @Inject
    @Channel("%o.channel%")
    Emitter<String> %o.emitter%;
}%

    @Incoming("%inputChannel%")
    public CompletionStage<Void> route(Message<String> msg) {
        ProcessEvent inputEvent = ProcessEvent.fromJson(msg.getPayload());
%outputs:{o|
%o.conditionBlock%
}%
        return msg.ack();
    }

    private boolean evaluateCondition(String expression, ProcessEvent event) {
        if (expression == null || expression.isBlank()) {
            return false;
        }
        String expr = expression.trim();
        if (expr.startsWith("${") && expr.endsWith("}")) {
            expr = expr.substring(2, expr.length() - 1).trim();
        }
        Map<String, Object> payload = event.payload();
        if (payload == null) {
            return false;
        }
        String operator = expr.contains("!=") ? "!=" : expr.contains("==") ? "==" : null;
        if (operator == null) {
            Object value = payload.get(expr);
            return value instanceof Boolean ? (Boolean) value : value != null;
        }
        String[] parts = expr.split(operator, 2);
        if (parts.length != 2) {
            return false;
        }
        String left = parts[0].trim();
        String right = parts[1].trim();
        Object value = payload.get(left);
        String literal = stripQuotes(right);
        if ("true".equalsIgnoreCase(literal) || "false".equalsIgnoreCase(literal)) {
            boolean expected = Boolean.parseBoolean(literal);
            if (value instanceof Boolean boolValue) {
                return operator.equals("==") == (boolValue == expected);
            }
            return operator.equals("==") == expected;
        }
        String actual = value != null ? value.toString() : null;
        boolean equals = actual != null && actual.equals(literal);
        return operator.equals("==") == equals;
    }

    private String stripQuotes(String value) {
        if ((value.startsWith("\"") && value.endsWith("\""))
                || (value.startsWith("'") && value.endsWith("'"))) {
            return value.substring(1, value.length() - 1);
        }
        return value;
    }
}
>>

